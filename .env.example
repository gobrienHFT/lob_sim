# =========================
# LOB SIM (Binance USD-M)
# =========================

# --- Credentials (NOT required for public market data; keep empty unless you later trade) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
# --- Endpoints ---
# Mainnet USD-M Futures
BINANCE_FAPI_BASE=https://fapi.binance.com
BINANCE_FWS_BASE=wss://fstream.binance.com

# (Optional) If you ever want testnet later:
# BINANCE_FAPI_BASE=https://demo-fapi.binance.com
# BINANCE_FWS_BASE=wss://fstream.binancefuture.com

# --- Symbols / streams ---
# Comma-separated
SYMBOLS=BTCUSDT

# Depth and trades use independent Binance USD-M public/market routes.
DEPTH_STREAM_SUFFIX=@depth@100ms
TRADE_STREAM_SUFFIX=@aggTrade

# REST snapshot depth limit: 5/10/20/50/100/500/1000
SNAPSHOT_LIMIT=1000

# Keep only top N levels in memory for features/metrics (still applies full diffs)
BOOK_TOP_N=20

# --- Collector ---
COLLECT_SECONDS=30
RECORD_DIR=./data
RECORD_FORMAT=ndjson
RECORD_GZIP=0
RECORD_FLUSH_EVERY=300
# Hard bound for off-event-loop disk/compression writes. Full means capture failure, never drop.
CAPTURE_WRITER_QUEUE_MAX=65536

# --- Networking / robustness ---
HTTP_TIMEOUT=10
HTTP_RETRIES=2

# Throttle REST calls (snapshot/exchangeInfo). Websocket is separate.
RATE_LIMIT_REQ_PER_SEC=8

WS_PING_INTERVAL=180
WS_PING_TIMEOUT=600
WS_RECONNECT_MAX_SEC=30

# If book diff sequence breaks, resnapshot immediately
RESYNC_ON_GAP=1

# Capture contract and explicit scenario controls
CAPTURE_SCHEMA_VERSION=3
SIM_MARKOUT_HORIZONS_MS=100,1000,5000
SIM_FILL_MODEL=trade

# --- Simulation (offline replay) ---
SIM_SEED=1

# Fill-assumption envelope: conservative, base, aggressive
FILL_PROFILE=base

# Latency model (applies to strategy actions in replay)
SIM_ORDER_LATENCY_MS=10
SIM_CANCEL_LATENCY_MS=10
SIM_LATENCY_MODE=fixed
# Optional comma-separated empirical samples (used when mode is empirical/stress_tail)
SIM_LATENCY_SAMPLES_MS=
SIM_LATENCY_STRESS_MULTIPLIER=1.0

# Simple maker strategy defaults
MM_ENABLED=1
MM_STRATEGY_PROFILE=baseline
MM_REQUOTE_MS=40
MM_ORDER_QTY=0.001
MM_MAX_POSITION=0.05
MM_HALF_SPREAD_BPS=0.05
MM_LAYERED_INNER_SPREAD_BPS=0.05
MM_LAYERED_OUTER_SPREAD_BPS=0.15
MM_SKEW_BPS_PER_UNIT=10.0
MM_VOLATILITY_WINDOW=30
MM_VOLATILITY_SPREAD_FACTOR=8.0
MM_QUEUE_REPOST_LOTS=0
MM_TRADE_IMBALANCE_WINDOW=12
MM_MICROSTRUCTURE_GATE_THRESHOLD=0.20
MM_MICROSTRUCTURE_GATE_BPS=0.10
MM_FEE_FLOOR_BUFFER_BPS=0.02
MM_TOXICITY_SPREAD_FACTOR=2.0
SIM_ADVERSE_MARKOUT_SECONDS=1.0

# Fees (bps). Maker can be negative (rebate) depending on venue/product; tune later.
FEES_MAKER_BPS=-0.2
FEES_TAKER_BPS=4.0

# --- Logging ---
LOG_LEVEL=INFO

# =========================
# LOB SIM (Binance USD-M)
# =========================

# Public market-data collection does not require credentials.
BINANCE_API_KEY=
BINANCE_API_SECRET=

BINANCE_FAPI_BASE=https://fapi.binance.com
BINANCE_FWS_BASE=wss://fstream.binance.com

SYMBOLS=BTCUSDT
DEPTH_STREAM_SUFFIX=@depth@100ms
TRADE_STREAM_SUFFIX=@aggTrade
SNAPSHOT_LIMIT=1000
BOOK_TOP_N=50

COLLECT_SECONDS=3600
RECORD_DIR=./data
RECORD_FORMAT=ndjson
RECORD_GZIP=1
RECORD_FLUSH_EVERY=2000

HTTP_TIMEOUT=10
HTTP_RETRIES=2
RATE_LIMIT_REQ_PER_SEC=8
WS_PING_INTERVAL=180
WS_PING_TIMEOUT=600
WS_RECONNECT_MAX_SEC=30
RESYNC_ON_GAP=1

SIM_ORDER_LATENCY_MS=25
SIM_CANCEL_LATENCY_MS=25

# `trade` is the conservative default: only matching aggTrade volume consumes
# queue. `depth` treats displayed level decreases as queue consumption and is
# an explicitly optimistic sensitivity model, not FIFO ground truth.
SIM_FILL_MODEL=trade

# Positive, unique horizons in milliseconds. The first midpoint observed at or
# after each target resolves the side-signed markout.
SIM_MARKOUT_HORIZONS_MS=100,1000,5000

MM_ENABLED=1
MM_REQUOTE_MS=250
MM_ORDER_QTY=0.001
MM_MAX_POSITION=0.01
MM_HALF_SPREAD_BPS=2.0
MM_SKEW_BPS_PER_UNIT=10.0

FEES_MAKER_BPS=-0.2
FEES_TAKER_BPS=4.0
LOG_LEVEL=INFO
